* witness-g6-4 | condition S6
Ipz pzn pzp SINE(0 1.2e-05 100)
Cpz pzp pzn 3e-08
Rpz pzp pzn 2e+07
RL out 0 1e+07
C1 0 n1 6.88482e-10
C2 n1 out 3.2693e-06
C3 0 out 4.7e-05
C4 n2 n3 1.02193e-05
C5 n3 pzp 4.7e-05
D1 0 n3 DSCH
D2 n1 n2 DSCH
D3 n2 out DSCH
D4 n3 n1 DSCH
D5 0 out DZ33
R1 0 pzn 6.135
Rbleed_pzp pzp 0 1G
Rbleed_pzn pzn 0 1G
Rbleed_n1 n1 0 1G
Rbleed_n2 n2 0 1G
Rbleed_n3 n3 0 1G
.model DSCH D(Is=5e-8 Rs=1 N=1.05 Cjo=10p BV=30 IBV=1u EG=0.69 XTI=2)
.model DSI D(Is=2.5n Rs=0.6 N=1.75 Cjo=4p BV=75 IBV=1u)
.model DZ33 D(Is=1e-12 Rs=5 N=1.5 BV=3.3 IBV=1u)
.model SWI SW(Ron=2 Roff=1G Vt=0.5 Vh=0)
.temp 60
.tran 0 0.8 0 2e-06
.save V(out) V(pzp) V(pzn) I(Ipz)
.meas TRAN vavg AVG V(out) FROM=0.7 TO=0.8
.meas TRAN vavg_prev AVG V(out) FROM=0.6 TO=0.7
.meas TRAN vpp PP V(out) FROM=0.7 TO=0.8
.meas TRAN vmax MAX V(out) FROM=0 TO=0.8
.meas TRAN tup FIND time WHEN V(out)=1.8 RISE=1
.meas TRAN pload AVG V(out)*V(out)/1e+07 FROM=0.7 TO=0.8
.meas TRAN pext AVG V(pzp,pzn)*I(Ipz) FROM=0.7 TO=0.8
.end
