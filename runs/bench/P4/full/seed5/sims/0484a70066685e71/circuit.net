* r02d1-screen1 | condition S2
Ipz pzn pzp SINE(0 2.5e-05 50)
Cpz pzp pzn 2.5e-08
Rpz pzp pzn 2e+07
Rsense out vsn 100
Vst vsn 0 1.8
C1 0 out 4.27469e-06
C2 n1 pzp 3.46815e-08
C3 n2 pzn 6.03249e-08
D1 n1 out DSCH
D2 n2 out DSCH
D3 pzn out DSCH
D4 pzp out DSCH
D5 0 out DZ33
Rbleed_pzp pzp 0 1G
Rbleed_pzn pzn 0 1G
Rbleed_n1 n1 0 1G
Rbleed_n2 n2 0 1G
.model DSCH D(Is=5e-8 Rs=1 N=1.05 Cjo=10p BV=30 IBV=1u EG=0.69 XTI=2)
.model DSI D(Is=2.5n Rs=0.6 N=1.75 Cjo=4p BV=75 IBV=1u)
.model DZ33 D(Is=1e-12 Rs=5 N=1.5 BV=3.3 IBV=1u)
.model SWI SW(Ron=2 Roff=1G Vt=0.5 Vh=0)
.temp 27
.tran 0 0.2 0 2e-06
.save V(out) V(vsn)
.meas TRAN isn AVG V(out,vsn) FROM=0.12 TO=0.2
.meas TRAN vout AVG V(out) FROM=0.12 TO=0.2
.end
