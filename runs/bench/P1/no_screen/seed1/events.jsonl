{"t": 485.56, "kind": "proposal", "iteration": 2, "k": 2, "move": "new_topology", "name": "sshi_half_gnd", "rationale": "A half-bridge rectifier with a synchronous flip is more efficient than a full-bridge because it only has one diode drop. By grounding pzn and harvesting on the positive peak of pzp, then flipping the voltage at the peak, we can achieve high power with fewer losses. This may provide a different energy profile that settles more quickly or has lower ripple.", "circuit": {"move": "new_topology", "name": "sshi_half_gnd", "rationale": "A half-bridge rectifier with a synchronous flip is more efficient than a full-bridge because it only has one diode drop. By grounding pzn and harvesting on the positive peak of pzp, then flipping the voltage at the peak, we can achieve high power with fewer losses. This may provide a different energy profile that settles more quickly or has lower ripple.", "done": false, "components": [{"id": "D1", "type": "D", "nodes": ["pzp", "out"], "model": "DSCH"}, {"id": "S1", "type": "S", "nodes": ["pzp", "n1"], "ctrl": "G1"}, {"id": "L1", "type": "L", "nodes": ["n1", "pzn"], "value": 0.002}, {"id": "R_gnd", "type": "R", "nodes": ["pzn", "0"], "value": 1.0}, {"id": "G1", "type": "SYNC", "ton": 3e-05, "phase": 0.0, "edges": "both"}, {"id": "C1", "type": "C", "nodes": ["out", "0"], "value": 2.2e-06}, {"id": "DZ1", "type": "D", "nodes": ["0", "out"], "model": "DZ33"}]}}
