* c0197-size01-6 | condition S2
Ipz pzn pzp SINE(0 6e-05 100)
Cpz pzp pzn 2.5e-08
Rpz pzp pzn 2e+07
RL out 0 1e+06
Ictl1 out 0 5e-07
C1 0 n1 1.09087e-06
C2 0 out 4.1395e-07
D1 0 pzn DSCH
D2 0 pzp DSCH
D3 n2 out DSCH
D4 pzn n1 DSCH
D5 pzp n1 DSCH
D6 n3 0 DZ33
L1 n1 n2 0.00524256 Rser=28.2128
R1 n3 out 1.17793e+07
S1 0 n2 G1_g 0 SWI
VG1 G1_g 0 PULSE(0 1 3.3153e-05 100n 100n 1.18916e-05 0.005)
Rbleed_pzp pzp 0 1G
Rbleed_pzn pzn 0 1G
Rbleed_n1 n1 0 1G
Rbleed_n2 n2 0 1G
Rbleed_n3 n3 0 1G
.model DSCH D(Is=5e-8 Rs=1 N=1.05 Cjo=10p BV=30 IBV=1u EG=0.69 XTI=2)
.model DSI D(Is=2.5n Rs=0.6 N=1.75 Cjo=4p BV=75 IBV=1u)
.model DZ33 D(Is=1e-12 Rs=5 N=1.5 BV=3.3 IBV=1u)
.model SWI SW(Ron=2 Roff=1G Vt=0.5 Vh=0)
.temp 27
.tran 0 0.8 0 2e-06
.save V(out) V(pzp) V(pzn) I(Ipz)
.meas TRAN vavg AVG V(out) FROM=0.7 TO=0.8
.meas TRAN vavg_prev AVG V(out) FROM=0.6 TO=0.7
.meas TRAN vpp PP V(out) FROM=0.7 TO=0.8
.meas TRAN vmax MAX V(out) FROM=0 TO=0.8
.meas TRAN tup FIND time WHEN V(out)=4.5 RISE=1
.meas TRAN pload AVG V(out)*V(out)/1e+06 FROM=0.7 TO=0.8
.meas TRAN pext AVG V(pzp,pzn)*I(Ipz) FROM=0.7 TO=0.8
.end
