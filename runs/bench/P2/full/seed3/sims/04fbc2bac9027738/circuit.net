* r07d1-screen1 | condition S6
Ipz pzn pzp SINE(0 6e-05 100)
Cpz pzp pzn 3e-08
Rpz pzp pzn 2e+07
Rsense out vsn 100
Vst vsn 0 4.5
Ictl1 out 0 5e-07
C1 0 out 1e-06
D1 0 pzn DSCH
D2 0 pzp DSCH
D3 n1 n2 DSCH
D4 n2 n3 DSCH
D5 out n1 DSCH
D6 pzn out DSCH
D7 pzp out DSCH
D8 n3 0 DZ33
L1 n4 pzp 0.0065 Rser=34.5
S1 n4 pzn G1_g 0 SWI
VG1 G1_g 0 PULSE(0 1 0.001 100n 100n 4.00476e-05 0.005)
Rbleed_pzp pzp 0 1G
Rbleed_pzn pzn 0 1G
Rbleed_n1 n1 0 1G
Rbleed_n2 n2 0 1G
Rbleed_n3 n3 0 1G
Rbleed_n4 n4 0 1G
.model DSCH D(Is=5e-8 Rs=1 N=1.05 Cjo=10p BV=30 IBV=1u EG=0.69 XTI=2)
.model DSI D(Is=2.5n Rs=0.6 N=1.75 Cjo=4p BV=75 IBV=1u)
.model DZ33 D(Is=1e-12 Rs=5 N=1.5 BV=3.3 IBV=1u)
.model SWI SW(Ron=2 Roff=1G Vt=0.5 Vh=0)
.temp 60
.tran 0 0.1 0 2e-06
.save V(out) V(vsn)
.meas TRAN isn AVG V(out,vsn) FROM=0.06 TO=0.1
.meas TRAN vout AVG V(out) FROM=0.06 TO=0.1
.end
